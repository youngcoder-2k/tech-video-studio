          { "id": "p2", "kind": "box", "x": 960, "y": 500, "w": 340, "h": 220, "label": "2. Generational GC", "sub": "Self-Healing Memory", "color": "#FACC15", "items": ["• Fast Eden bump alloc", "• Sweep 90% short-lived", "• Promote to Old Gen"], "initial": true },
          { "id": "p3", "kind": "box", "x": 1580, "y": 500, "w": 320, "h": 220, "label": "3. HotSpot JIT", "sub": "Adaptive Native Speed", "color": "#34D399", "items": ["• Profile hot loops", "• C2 inline & unroll", "• Bare-metal CPU exec"], "initial": true }
        ]
      },
      "beats": [
        {
          "role": "synthesis",
          "duration": 10,
          "title": "How All Three Pillars Work Together",
          "subtitle": "Portability, memory safety, and native speed in one runtime.",
          "accent": "#34D399",
          "narration": "Put it all together and the JVM's brilliance is clear. ClassLoaders guarantee portability and safety, Generational Garbage Collection automates memory at scale, and the HotSpot JIT turns hot bytecode into native speed.",
          "actions": [
            { "type": "spotlight", "targets": ["p1"], "p": 0.06, "pUntil": 0.34 },
            { "type": "mutate", "target": "p1", "p": 0.12, "badge": "PORTABLE ✔", "status": "ok" },
            { "type": "connect", "from": "p1", "to": "p2", "p": 0.30, "dur": 0.4, "color": "#38BDF8" },
            { "type": "packet", "from": "p1", "to": "p2", "p": 0.34, "dur": 0.7, "label": "SAFE", "color": "#38BDF8" },
            { "type": "spotlight", "targets": ["p2"], "p": 0.35, "pUntil": 0.64 },
            { "type": "mutate", "target": "p2", "p": 0.42, "badge": "AUTO GC ✔", "status": "ok" },
            { "type": "connect", "from": "p2", "to": "p3", "p": 0.60, "dur": 0.4, "color": "#FACC15" },
            { "type": "packet", "from": "p2", "to": "p3", "p": 0.64, "dur": 0.7, "label": "LIVE", "color": "#FACC15" },
            { "type": "spotlight", "targets": ["p3"], "p": 0.65, "pUntil": 0.86 },
            { "type": "mutate", "target": "p3", "p": 0.72, "badge": "100x JIT ✔", "status": "ok" },
            { "type": "clearSpotlight", "p": 0.87 }
          ],
          "takeaway": "JVM = Portable Bytecode + Self-Managing Heap + Adaptive Native Speed"
        }
      ]
    }
  ]
