      "backdrop": "waves",
      "beats": [
        {
          "type": "dashed-group-stack",
          "duration": 12,
          "narration": "With Escape Analysis, the JIT detects local-only objects. It skips Heap allocation entirely and removes useless locks.",
          "header": "JIT Escape Analysis",
          "subtitle": "Local-only objects never touch the Heap or GC",
          "stackTitle": "Scalar Replaced",
          "stackItems": ["x = obj.x", "y = obj.y", "lock elided ✔", "0 Heap bytes"],
          "pillColor": "#10B981",
          "arrowLabel": "0 GC Pressure",
          "dbLabel": "CPU Registers",
          "takeaway": "Escape Analysis Eliminates Heap Allocations and Unnecessary Locks Automatically",
          "tag": "ESCAPE ANALYSIS"
        },
        {
          "type": "versus-gauge",
          "duration": 12,
          "narration": "This is why JVM services speed up over time. After warmup, JIT-compiled code runs over ten times faster.",
          "left": {
            "icon": "warningAlert",
            "tag": "COLD START ❌",
