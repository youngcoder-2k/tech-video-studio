            { "title": "Interpreter", "sub": "Line-by-Line Decode", "fill": "#F59E0B", "textColor": "#0F172A", "icon": "magnifyingGlass" },
            { "title": "CPU Execution", "sub": "Fast Boot, Slower Loops", "fill": "#22D3EE", "textColor": "#0F172A", "icon": "cpuSilicon" }
          ],
          "takeaway": "The Bytecode Interpreter Gives Instant Startup Before Heavy Optimizations Kick In",
          "tag": "INTERPRETER"
        },
