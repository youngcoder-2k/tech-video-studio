              "color": "#F87171"
            },
            {
              "type": "do",
              "title": "Modern GC + Warmup Probes",
              "cmd": "✔ -XX:+UseZGC + Startup Warmup",
              "desc": "Locks in sub-millisecond GC pauses and peak native speed",
              "color": "#38BDF8"
            }
          ],
          "takeaway": "Cap Heap at 75% RAM, Pick G1GC or ZGC, and Warm Up HotSpot Before Peak Traffic"
