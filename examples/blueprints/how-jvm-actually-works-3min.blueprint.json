        {
          "type": "scorecard",
          "duration": 12,
          "narration": "In production, size your Heap cleanly, choose G1GC or ZGC, and warm up services before serving traffic.",
          "items": [
            {
              "type": "dont",
              "title": "Unbounded Container Heap",
              "cmd": "❌ Default RAM without limits",
              "desc": "Triggers sudden Kubernetes OOMKill under traffic spikes",
              "color": "#F87171"
            },
            {
              "type": "do",
              "title": "Explicit Heap Percentage",
              "cmd": "✔ -XX:MaxRAMPercentage=75.0",
              "desc": "Leaves 25% headroom for Metaspace, Code Cache, and stacks",
              "color": "#34D399"
            },
            {
              "type": "dont",
              "title": "Sending Cold Traffic Immediately",
              "cmd": "❌ 100% load before JIT warmup",
