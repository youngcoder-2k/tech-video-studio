      "backdrop": "isometric",
      "beats": [
        {
          "type": "commit-log-stream",
          "duration": 12,
          "narration": "Most Java objects die very young. So the JVM allocates new objects rapidly inside Eden Space.",
          "source": {
            "icon": "lightningBolt",
            "tag": "NEW OBJECTS",
            "title": "Bump-Pointer Alloc",
            "sub": "O(1) Allocation",
            "color": "#FACC15"
          },
          "arrowLabel": "Instant TLAB Alloc",
          "tapeTitle": "Young Generation — Eden Space Allocation Strip",
          "cells": [
            { "label": "Obj #1", "sub": "Short-Lived", "color": "#38BDF8", "bg": "rgba(56, 189, 248, 0.18)", "span": 1 },
            { "label": "Obj #2", "sub": "Short-Lived", "color": "#38BDF8", "bg": "rgba(56, 189, 248, 0.18)", "span": 1 },
            { "label": "Obj #3", "sub": "Short-Lived", "color": "#38BDF8", "bg": "rgba(56, 189, 248, 0.18)", "span": 1 },
            { "label": "Bump Ptr ⚡", "sub": "ALLOC HEAD", "color": "#FACC15", "bg": "rgba(250, 204, 21, 0.30)", "span": 1.3 },
            { "label": "Free Eden", "sub": "Zero Locks ->", "color": "#34D399", "bg": "rgba(52, 211, 153, 0.14)", "span": 1.2, "dashed": true }
          ],
          "takeaway": "95% of Objects Die Young — Eden Space Makes Allocation as Fast as Incrementing a Pointer",
          "tag": "EDEN SPACE"
        },
        {
          "type": "flat-step-flow",
          "duration": 12,
          "direction": "horizontal",
          "narration": "Minor GC clears dead objects from Eden in milliseconds. Survivors age and get promoted into Old Generation.",
          "steps": [
            { "title": "1. Eden", "sub": "New Allocations", "fill": "#00B894", "textColor": "#FFFFFF", "icon": "ramChip", "arrowLabel": "Minor GC" },
            { "title": "2. Survivor", "sub": "S0 <-> S1 Copy", "fill": "#22D3EE", "textColor": "#0F172A", "icon": "shieldGuard", "arrowLabel": "Age >= 15" },
            { "title": "3. Old Gen", "sub": "Long-Lived Data", "fill": "#A78BFA", "textColor": "#0F172A", "icon": "hardDiskPlatter" }
          ],
          "takeaway": "Generational GC Isolates Short-Lived Objects So Minor Collections Finish in Milliseconds",
          "tag": "GENERATIONAL GC"
        },
        {
          "type": "comparison-cards",
          "duration": 12,
          "narration": "Modern collectors eliminate long freezes. G1GC balances throughput, while ZGC keeps pause times under one millisecond.",
          "left": {
            "title": "G1GC (Default Collector)",
            "headerBg": "#6E7A3B",
            "bodyBg": "#213D37",
            "bullets": [
              "Splits Heap into equal regions",
