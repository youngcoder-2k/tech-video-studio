      "chapter": "01. Write Once, Run Anywhere & Class Loading",
      "backdrop": "waves",
      "beats": [
        {
          "type": "pill-chain",
          "duration": 12,
          "narration": "How does Java run on every machine? First, javac compiles your source code into portable bytecode.",
          "heroMetric": "WRITE ONCE, RUN ANYWHERE",
          "heroSub": "Java Source -> Platform-Neutral Bytecode",
          "pills": ["Main.java", "javac Compiler", "Main.class", "JVM Runtime"],
          "takeaway": "javac Compiles Java Source Code Into Platform-Independent .class Bytecode",
          "tag": "BYTECODE"
        },
        {
          "type": "wireframe-fanout",
          "duration": 12,
          "narration": "Instead of targeting one CPU, bytecode runs inside a JVM. The same file runs on any OS.",
          "source": {
            "badge": "CLASS",
            "title": "Main.class (Bytecode)",
            "color": "#10B981"
          },
          "targets": [
            { "badge": "LINUX", "title": "Linux x86_64 JVM", "color": "#22D3EE", "arrowLabel": "Same Bytecode" },
            { "badge": "MACOS", "title": "Apple Silicon JVM", "color": "#10B981", "arrowLabel": "Same Bytecode" },
            { "badge": "WIN", "title": "Windows JVM", "color": "#FACC15", "arrowLabel": "Same Bytecode" }
          ],
          "takeaway": "Each Operating System Runs Its Own JVM to Execute the Exact Same Bytecode",
          "tag": "PORTABILITY"
        },
        {
          "type": "flat-step-flow",
          "duration": 12,
          "direction": "horizontal",
          "narration": "At startup, the ClassLoader reads bytecode into memory. It verifies security, prepares static fields, and initializes classes.",
          "steps": [
            { "title": "1. Loading", "sub": "Read .class Bytes", "fill": "#00B894", "textColor": "#FFFFFF", "icon": "javaLogo" },
            { "title": "2. Linking", "sub": "Verify & Prepare", "fill": "#22D3EE", "textColor": "#0F172A", "icon": "shieldGuard" },
            { "title": "3. Init", "sub": "Run Static Blocks", "fill": "#F59E0B", "textColor": "#0F172A", "icon": "lightningBolt" }
          ],
          "takeaway": "The JVM ClassLoader Verifies Bytecode Safety Before Any Code Executes",
          "tag": "CLASSLOADER"
        }
      ]
    },
    {
      "id": "scene-2-runtime-memory-areas",
      "chapter": "02. JVM Memory Areas: Stack, Heap & Metaspace",
      "backdrop": "blueprint",
      "beats": [
        {
          "type": "dashed-group-stack",
          "duration": 12,
          "narration": "Every thread gets its own private Stack. Method calls push frames onto it, storing local variables safely.",
          "header": "Per-Thread JVM Stack",
          "subtitle": "Thread-private LIFO frames — zero lock contention",
          "stackTitle": "Thread #1 Stack",
          "stackItems": ["main() frame", "process() frame", "calc() frame", "local vars"],
          "pillColor": "#EF4444",
          "arrowLabel": "Object References",
          "dbLabel": "Shared Heap",
          "takeaway": "Each Thread Owns a Private Stack for Fast, Lock-Free Method Execution",
          "tag": "THREAD STACK"
        },
        {
          "type": "comparison-cards",
          "duration": 12,
          "narration": "While stacks are private per thread, the Heap is shared. Every object you allocate lives on the Heap.",
          "left": {
            "title": "JVM Thread Stack",
            "headerBg": "#6E7A3B",
            "bodyBg": "#213D37",
            "bullets": [
              "Private to each thread",
              "Stores primitives & refs",
              "Auto-freed on return",
              "Fast LIFO memory access"
            ]
          },
          "right": {
            "title": "Shared JVM Heap",
            "headerBg": "#0F766E",
            "bodyBg": "#19373D",
            "bullets": [
              "Shared across all threads",
              "Stores all Objects & Arrays",
              "Managed by Garbage Collector",
              "Sized via -Xms and -Xmx"
            ]
          },
          "takeaway": "Stack Frames Store Local References While the Shared Heap Holds All Objects",
          "tag": "STACK VS HEAP"
        },
        {
          "type": "flat-step-flow",
          "duration": 12,
          "direction": "vertical",
          "narration": "Class definitions and method bytecode live in Metaspace. Metaspace uses native OS memory, separate from the Heap.",
          "steps": [
            {
              "title": "JVM Heap",
              "sub": "Live Object Instances",
              "fill": "#00B894",
              "textColor": "#FFFFFF",
              "icon": "ramChip",
              "arrowLabel": "Class Pointer"
            },
            {
              "title": "Metaspace (Native)",
              "sub": "Class Metadata & Bytecode",
              "fill": "#22D3EE",
              "textColor": "#0F172A",
              "icon": "cpuSilicon"
            }
          ],
          "takeaway": "Metaspace Stores Class Blueprints in Native Memory Outside the Java Heap",
          "tag": "METASPACE"
        }
      ]
    },
    {
